<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- T-040 coverage gate: exactly one gate per assembly — this project owns NewsQuack.Infrastructure.dll
         (70% line floor). NewsQuack.Core is gated by NewsQuack.Core.Tests (90%) and not measured here, so a
         later task's new Core code can only fail the gate of its own test project. ThresholdStat=minimum
         applies the threshold per measured assembly. -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>minimum</ThresholdStat>
    <Threshold>70</Threshold>
    <!-- Measure only NewsQuack.Infrastructure.dll (coverlet filter syntax: [module]type). -->
    <Include>[NewsQuack.Infrastructure]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="WireMock.Net" />
    <!-- coverlet.collector: VSTest data collector (per spec). coverlet.msbuild: MSBuild task that emits the
         cobertura report after every test run and fails the build when Threshold is violated. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitively brings NewsQuack.Core, NewsQuack.Infrastructure (and the EF Core SQLite provider). -->
    <ProjectReference Include="../../src/NewsQuack.App/NewsQuack.App.csproj" />
  </ItemGroup>

</Project>
